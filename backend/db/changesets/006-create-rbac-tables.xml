<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="006-create-rbac-tables" author="nfc-admin">
        <comment>RBAC: roles, permissions, and junction tables</comment>

        <!-- Roles -->
        <createTable schemaName="nfc_admin" tableName="roles">
            <column name="id" type="SERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(200)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
        </createTable>

        <!-- Permissions -->
        <createTable schemaName="nfc_admin" tableName="permissions">
            <column name="id" type="SERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(200)"/>
        </createTable>

        <!-- Junction: user_roles -->
        <createTable schemaName="nfc_admin" tableName="user_roles">
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false"
                             foreignKeyName="fk_user_roles_user"
                             references="nfc_admin.users(id)"
                             deleteCascade="true"/>
            </column>
            <column name="role_id" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_user_roles_role"
                             references="nfc_admin.roles(id)"
                             deleteCascade="true"/>
            </column>
            <column name="assigned_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
        </createTable>
        <addPrimaryKey schemaName="nfc_admin" tableName="user_roles"
                       columnNames="user_id, role_id"
                       constraintName="pk_user_roles"/>

        <!-- Junction: role_permissions -->
        <createTable schemaName="nfc_admin" tableName="role_permissions">
            <column name="role_id" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_role_perms_role"
                             references="nfc_admin.roles(id)"
                             deleteCascade="true"/>
            </column>
            <column name="permission_id" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_role_perms_perm"
                             references="nfc_admin.permissions(id)"
                             deleteCascade="true"/>
            </column>
        </createTable>
        <addPrimaryKey schemaName="nfc_admin" tableName="role_permissions"
                       columnNames="role_id, permission_id"
                       constraintName="pk_role_permissions"/>

        <rollback>
            <dropTable schemaName="nfc_admin" tableName="role_permissions"/>
            <dropTable schemaName="nfc_admin" tableName="user_roles"/>
            <dropTable schemaName="nfc_admin" tableName="permissions"/>
            <dropTable schemaName="nfc_admin" tableName="roles"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
