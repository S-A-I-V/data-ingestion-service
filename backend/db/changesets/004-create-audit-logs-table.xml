<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-audit-logs-table" author="nfc-admin">
        <comment>Audit logs with hash-chain integrity for tamper detection</comment>
        <createTable schemaName="nfc_admin" tableName="audit_logs">
            <column name="id" type="SERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false"
                             foreignKeyName="fk_audit_user_id"
                             references="nfc_admin.users(id)"/>
            </column>
            <column name="user_email" type="VARCHAR(320)">
                <constraints nullable="false"/>
            </column>
            <column name="connection_id" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_audit_connection_id"
                             references="nfc_admin.db_connections(id)"/>
            </column>
            <column name="connection_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="operation" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="table_name" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="row_count" type="INTEGER"/>
            <column name="query_preview" type="TEXT"/>
            <column name="ai_suggestion" type="TEXT"/>
            <column name="status" type="VARCHAR(20)" defaultValue="success">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="TEXT"/>
            <column name="executed_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
            <!-- Execution metrics -->
            <column name="rows_inserted" type="INTEGER"/>
            <column name="rows_skipped" type="INTEGER"/>
            <column name="throughput_rps" type="DOUBLE"/>
            <column name="file_size_bytes" type="BIGINT"/>
            <column name="data_size_bytes" type="BIGINT"/>
            <column name="parse_time_ms" type="INTEGER"/>
            <column name="ingestion_time_ms" type="INTEGER"/>
            <column name="total_time_ms" type="INTEGER"/>
            <column name="error_rows" type="INTEGER"/>
            <column name="duplicate_count" type="INTEGER"/>
            <column name="validation_score" type="DOUBLE"/>
            <column name="peak_memory_bytes" type="BIGINT"/>
            <column name="cpu_time_s" type="DOUBLE"/>
            <!-- Hash chain -->
            <column name="prev_hash" type="VARCHAR(64)"/>
            <column name="record_hash" type="VARCHAR(64)"/>
        </createTable>

        <!-- Indexes for common query patterns -->
        <createIndex schemaName="nfc_admin" tableName="audit_logs" indexName="idx_audit_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex schemaName="nfc_admin" tableName="audit_logs" indexName="idx_audit_connection_id">
            <column name="connection_id"/>
        </createIndex>
        <createIndex schemaName="nfc_admin" tableName="audit_logs" indexName="idx_audit_status">
            <column name="status"/>
        </createIndex>
        <createIndex schemaName="nfc_admin" tableName="audit_logs" indexName="idx_audit_executed_at">
            <column name="executed_at"/>
        </createIndex>
        <createIndex schemaName="nfc_admin" tableName="audit_logs" indexName="idx_audit_user_time">
            <column name="user_id"/>
            <column name="executed_at"/>
        </createIndex>
        <createIndex schemaName="nfc_admin" tableName="audit_logs" indexName="idx_audit_connection_time">
            <column name="connection_id"/>
            <column name="executed_at"/>
        </createIndex>
        <createIndex schemaName="nfc_admin" tableName="audit_logs" indexName="idx_audit_status_time">
            <column name="status"/>
            <column name="executed_at"/>
        </createIndex>

        <rollback>
            <dropTable schemaName="nfc_admin" tableName="audit_logs"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
