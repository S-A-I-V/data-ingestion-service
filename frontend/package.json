{
  "name": "@nielsen-media/nfc-ingestion-fe",
  "private": true,
  "version": "1.0.0",
  "main": "build/nfc/index.js",
  "files": [
    "build/nfc/**/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rm -rf ./build/nfc",
    "clean:env": "node scripts/clean-env.js",
    "typecheck": "tsc --noEmit",
    "build:maf": "yarn clean && webpack --config conf/webpack.build.config.js",
    "build:dev": "ENVIRONMENT=dev yarn clean && ENVIRONMENT=dev NODE_ENV=production webpack --config conf/webpack.production.config.js",
    "build:qa": "ENVIRONMENT=qa yarn clean && ENVIRONMENT=qa NODE_ENV=production webpack --config conf/webpack.production.config.js",
    "build:prod": "ENVIRONMENT=prod yarn clean && ENVIRONMENT=prod NODE_ENV=production webpack --config conf/webpack.production.config.js",
    "build:nfc-admin": "ENVIRONMENT=dev NODE_ENV=production webpack --config conf/webpack.nfc-admin.config.js",
    "watch:maf": "ENVIRONMENT=dev REACT_APP_IS_LOCAL_DEV=true webpack --config conf/webpack.development.config.js --watch"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "3.9.0",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@tailwindcss/vite": "^4.3.0",
    "@xyflow/react": "^12.11.0",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.38.0",
    "gsap": "3.12.5",
    "lucide-react": "^1.14.0",
    "motion": "^12.39.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "7.53.0",
    "react-router-dom": "^6.26.2",
    "recharts": "^3.10.1",
    "sql-formatter": "15.4.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "assets-webpack-plugin": "7.1.1",
    "css-loader": "^7.1.2",
    "dotenv": "^16.4.5",
    "dotenv-webpack": "^8.1.1",
    "postcss": "^8.4.38",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.8.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "5.3.10",
    "trash-cli": "5.0.0",
    "ts-loader": "9.5.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "webpack": "5.94.0",
    "webpack-cli": "5.1.4",
    "webpack-merge": "6.0.1",
    "workbox-window": "^7.4.1"
  }
}
