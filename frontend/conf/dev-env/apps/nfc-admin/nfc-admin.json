  "ui_toggles": [
    {
      "name": "CONNECTIONS_WRITE",
      "description": "Allow creating, updating, deleting, and testing connections",
      "dependency_rest_actions": [
        { "path": "/api/connections/?$", "method": "POST" },
        { "path": "/api/connections/[0-9]+$", "method": "PUT" },
        { "path": "/api/connections/[0-9]+$", "method": "DELETE" },
        { "path": "/api/connections/[0-9]+/test$", "method": "POST" }
      ]
    },
    {
      "name": "INGESTION_WRITE",
      "description": "Allow previewing and executing data ingestion",
      "dependency_rest_actions": [
        { "path": "/api/ingestion/preview$", "method": "POST" },
        { "path": "/api/ingestion/execute$", "method": "POST" }
      ]
    },
    {
      "name": "REPORT_MAPPING_WRITE",
      "description": "Allow creating, updating, deleting, previewing, and applying report mappings",
      "dependency_rest_actions": [
        { "path": "/api/admin/report-mapping/saved$", "method": "POST" },
        { "path": "/api/admin/report-mapping/saved/[a-f0-9-]+$", "method": "PUT" },
        { "path": "/api/admin/report-mapping/saved/[a-f0-9-]+$", "method": "DELETE" },
        { "path": "/api/admin/report-mapping/preview-changes$", "method": "POST" },
        { "path": "/api/admin/report-mapping/apply-changes$", "method": "POST" }
      ]
    },
    {
      "name": "REPORT_POLICIES_WRITE",
      "description": "Allow previewing and applying report policy changes",
      "dependency_rest_actions": [
        { "path": "/api/admin/report-policies/preview$", "method": "POST" },
        { "path": "/api/admin/report-policies/apply$", "method": "POST" }
      ]
    },
    {
