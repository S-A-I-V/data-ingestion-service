# QA / Staging Environment Configuration (MAF Alpha)
REACT_APP_ENVIRONMENT=qa
REACT_APP_APP_NAME=NFC
REACT_APP_APP_DISPLAY_CODE=nfc-staging

# API Configuration
REACT_APP_API_BASE_URL=/api

# MAF Configuration
